<mujoco model="MEAM5170 planar pushing">
  <compiler angle="radian"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"
          solver="Newton" cone="elliptic" iterations="100" tolerance="1e-10">
    <flag autoreset="disable"/>
  </option>
  <default>
    <!-- Only the two explicit pairs below can collide. -->
    <geom contype="0" conaffinity="0"/>
    <pair condim="3" solref="0.01 1" solimp="0.95 0.99 0.001"/>
  </default>
  <visual><global azimuth="110" elevation="-65" offwidth="1000" offheight="750"/></visual>
  <statistic center="0.06 0 0" extent="0.4"/>
  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.22 0.25 0.30" rgb2="0.28 0.31 0.36"/>
    <material name="table_mat" texture="grid" texrepeat="10 10" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="0 -0.3 1" dir="0 0 -1"/>
    <geom name="table" type="plane" size="1 1 0.05" material="table_mat"/>
    <!-- RGB world axes: X red, Y green, Z blue; visual only. -->
    <geom type="capsule" fromto="0 0 0.001 0.1 0 0.001" size="0.0007" rgba="1 0.2 0.2 1"/>
    <geom type="capsule" fromto="0 0 0.001 0 0.1 0.001" size="0.0007" rgba="0.2 1 0.2 1"/>
    <geom type="capsule" fromto="0 0 0.001 0 0 0.06" size="0.0007" rgba="0.2 0.4 1 1"/>
    <body name="slider" pos="0 0 0.0102">
      <freejoint name="slider_free"/>
      <geom name="slider_geom" type="box" size="0.06 0.04 0.01" mass="0.2" rgba="0.15 0.55 0.85 1"/>
      <site name="slider_heading" pos="0.045 0 0.0105" size="0.003" rgba="1 1 1 1"/>
    </body>
    <body name="pusher" mocap="true" pos="-0.073 0 0.01">
      <geom name="pusher_geom" type="cylinder" size="0.01 0.008" rgba="0.95 0.4 0.12 1"/>
    </body>
    <body name="goal" pos="0.12 0.03 0.001" euler="0 0 0.4">
      <geom name="goal_left" type="capsule" fromto="-0.06 -0.04 0 -0.06 0.04 0" size="0.001" rgba="0.25 1 0.5 0.8"/>
      <geom name="goal_right" type="capsule" fromto="0.06 -0.04 0 0.06 0.04 0" size="0.001" rgba="0.25 1 0.5 0.8"/>
      <geom name="goal_bottom" type="capsule" fromto="-0.06 -0.04 0 0.06 -0.04 0" size="0.001" rgba="0.25 1 0.5 0.8"/>
      <geom name="goal_top" type="capsule" fromto="-0.06 0.04 0 0.06 0.04 0" size="0.001" rgba="0.25 1 0.5 0.8"/>
      <geom name="goal_heading" type="capsule" fromto="0 0 0 0.04 0 0" size="0.001" rgba="0.25 1 0.5 0.8"/>
    </body>
  </worldbody>
  <contact>
    <pair name="ground_slider" geom1="table" geom2="slider_geom" friction="0.3 0.3 0.001 0.0001 0.0001"/>
    <pair name="pusher_slider" geom1="pusher_geom" geom2="slider_geom" friction="0.5 0.5 0.001 0.0001 0.0001"/>
  </contact>
</mujoco>
